generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ───────────────────────────────────────────────────────────────────

enum AccountType {
  SAVINGS
  CHECKING
  CREDIT_CARD
  INVESTMENT
  CASH
  OTHER
}

enum TransactionType {
  INCOME
  EXPENSE
}

// What a ledger entry means for the household's money. `type` still says which
// way the account balance moved; `kind` says what the money was for.
enum TransactionKind {
  INCOME   // salary, bonus, interest, refunds
  SPEND    // everyday spending, bills, the card bill
  TRANSFER // between our own accounts (two legs, one transferGroupId)
  SAVE     // SIP, RD, gold scheme and other investment payments
  DEBT     // loan and card EMIs, prepayments
  ADJUST   // balance corrections
}

enum AssetType {
  STOCK
  MUTUAL_FUND
  SIP
  CRYPTO
  ETF
  FIXED_DEPOSIT
  RECURRING_DEPOSIT
  REAL_ESTATE
  GOLD
  GOLD_SCHEME
  VEHICLE
  OTHER
}

enum LoanType {
  HOME
  CAR
  PERSONAL
  EDUCATION
  BUSINESS
  OTHER
}

enum P2PType {
  LENT
  BORROWED
}

enum BillFrequency {
  ONE_TIME
  WEEKLY
  BIWEEKLY
  MONTHLY
  EVERY_2_MONTHS
  QUARTERLY
  EVERY_4_MONTHS
  HALF_YEARLY
  YEARLY
  CUSTOM
}

enum BillStatus {
  ACTIVE
  PAUSED
  ARCHIVED
}

// How a scheduled instalment was settled. AUTO = confirmed automatically on its
// due date (auto-debit); it is undone exactly like PAID.
enum DuePaymentStatus {
  PAID
  SKIPPED
  AUTO
}

enum GoalType {
  FARM_HOUSE
  EMERGENCY_FUND
  RELOCATION
  CAR_PURCHASE
  RETIREMENT
  TRAVEL
  EDUCATION
  CUSTOM
}

enum GoalPriority {
  CRITICAL
  HIGH
  MEDIUM
  LOW
}

enum GoalRiskLevel {
  LOW
  MEDIUM
  HIGH
}

enum GoalStatus {
  ACTIVE
  PAUSED
  COMPLETED
  ABANDONED
}

enum ContributionType {
  RECURRING
  ONE_TIME
}

enum SplitEntityType {
  TRANSACTION
  INVESTMENT
  LOAN
  BILL
  CARD_EMI
}

// ─── Models ──────────────────────────────────────────────────────────────────

model User {
  dueStatuses     DueStatus[]
  settings        UserSettings?
  monthCloses     MonthClose[]
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  currency     String   @default("INR")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  accounts      Account[]
  categories    Category[]
  transactions  Transaction[]
  investments   Investment[]
  goals         Goal[]
  loans         Loan[]
  recurringBills  RecurringBill[]
  creditCards   CreditCard[]
  p2pLoans      P2PLoan[]
  cardEmis      CardEMI[]
  familyMembers FamilyMember[]
  refreshTokens RefreshToken[]
  budgets       Budget[]
  netWorthSnapshots   NetWorthSnapshot[]
  goalContributions   GoalContribution[]
  ownershipSplits     OwnershipSplit[]
  monthlySalaries     MonthlySalary[]
  loanEvents          LoanEvent[]
  cardStatements      CardStatement[]
  cardExpenses        CardExpense[]

  @@map("users")
}

model FamilyMember {
  id        String   @id @default(cuid())
  userId    String
  name      String
  relation  String?
  color     String?
  emoji     String?
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user              User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  ownedAccounts     Account[]
  transactions      Transaction[]  @relation("TxnPrimary")
  investments       Investment[]   @relation("InvPrimary")
  loans             Loan[]         @relation("LoanBorrower")
  loanPayments      Loan[]         @relation("LoanPayer")
  creditCards       CreditCard[]
  p2pLoans          P2PLoan[]
  recurringBills    RecurringBill[]
  cardEmis          CardEMI[]
  goals             Goal[]
  secondaryOwnershipSplits OwnershipSplit[] @relation("SplitSecondaryMember")
  monthlySalaries   MonthlySalary[]
  cardExpenses      CardExpense[]

  @@index([userId])
  @@map("family_members")
}

model Account {
  id        String      @id @default(cuid())
  userId    String
  memberId  String?
  name      String
  type      AccountType
  balance   Decimal     @default(0) @db.Decimal(14, 2)
  bankName  String?
  preferredMinimum Decimal @default(0) @db.Decimal(14, 2)
  isActive  Boolean @default(true)
  currency  String      @default("INR")
  color     String?
  icon      String?
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  user         User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  member       FamilyMember?  @relation(fields: [memberId], references: [id], onDelete: SetNull)
  transactions   Transaction[]
  investments    Investment[]    @relation("InvestmentBankAccount")
  loans          Loan[]          @relation("LoanBankAccount")
  goalsFunded    Goal[]          @relation("GoalFundingAccount")
  recurringBills RecurringBill[] @relation("BillAccount")
  paymentCards CreditCard[] @relation("CardPaymentAccount")
  salaries     MonthlySalary[] @relation("SalaryAccount")

  @@index([userId])
  @@index([memberId])
  @@map("accounts")
}

model Category {
  id        String          @id @default(cuid())
  userId    String?
  name      String
  icon      String?
  color     String?
  type      TransactionType
  isDefault Boolean         @default(false)
  createdAt DateTime        @default(now())

  user         User?         @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions Transaction[]
  budgets      Budget[]
  bills        RecurringBill[] @relation("BillCategory")
  cardExpenses CardExpense[]   @relation("CardExpenseCategory")

  @@index([userId])
  @@map("categories")
}

model Transaction {
  id          String          @id @default(cuid())
  userId      String
  accountId      String?
  categoryId     String?
  memberId       String?
  type           TransactionType
  amount         Decimal   @db.Decimal(14, 2)
  description    String?
  notes          String?
  date           DateTime
  isRecurring    Boolean   @default(false)
  // True for the principal portion of an EMI on a loan linked to an asset --
  // still real cash leaving the account (kept as type EXPENSE for balance
  // accounting), but excluded from expense analytics: it builds equity, not spend.
  isWealthTransfer Boolean @default(false)
  // What the money did, for every total in the app (see backend/src/metrics).
  kind            TransactionKind @default(SPEND)
  // What created this entry (LOAN, INVESTMENT, BILL, CREDIT_CARD, CARD_EXPENSE,
  // LOAN_EVENT, SALARY, ...) and that record's id; null for hand-typed entries.
  sourceType      String?
  sourceId        String?
  // The month (YYYY-MM) a scheduled payment belongs to, which can differ from `date`.
  period          String?
  // Both legs of a transfer between own accounts share this id.
  transferGroupId String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  user        User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  account     Account?       @relation(fields: [accountId], references: [id], onDelete: SetNull)
  category    Category?      @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  member      FamilyMember?  @relation("TxnPrimary",  fields: [memberId],      references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([userId, date])
  @@index([userId, type])
  @@index([categoryId])
  @@index([memberId])
  @@index([userId, kind, date])
  @@index([sourceType, sourceId])
  @@index([transferGroupId])
  @@map("transactions")
}

model Investment {
  paymentDay Int? // optional recurring contribution day
  recurringActive Boolean @default(true) // stop future contributions without deleting the holding
  autoDebit  Boolean @default(false) // the bank takes the instalment itself (RDs by default): confirmed on its due date
  id           String    @id @default(cuid())
  userId       String
  assetName    String
  assetType    AssetType
  ticker       String?
  quantity     Decimal   @default(0) @db.Decimal(18, 6)
  buyPrice     Decimal   @default(0) @db.Decimal(14, 2)
  currentPrice Decimal   @default(0) @db.Decimal(14, 2)
  purchaseDate DateTime
  exchange     String?
  notes        String?

  // SIP / Mutual Fund
  monthlyAmount Decimal? @db.Decimal(14, 2)   // monthly SIP / RD / gold scheme installment
  fundCategory  String?                         // Equity, Debt, Hybrid, ELSS, Index
  folioNumber   String?                         // MF / SIP folio number

  // Recurring Deposit & Fixed Deposit & Gold Scheme
  maturityDate   DateTime?
  maturityAmount Decimal?  @db.Decimal(14, 2)
  interestRate   Decimal?  @db.Decimal(5, 2)

  // Common
  platform       String?
  pauseFrom         String?  // YYYY-MM: no instalments from this month
  pauseUntil        String?  // YYYY-MM: last paused month (null = until resumed)
  nextMonthlyAmount Decimal? @db.Decimal(14, 2) // new instalment amount ...
  nextAmountFrom    String?  // ... from this month (YYYY-MM)
  memberId       String?    // primary owner
  bankAccountId  String?

  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  // When units, the price (NAV) or the value were last entered; the Health check flags old ones.
  priceUpdatedAt DateTime?
  // SIPs and mutual funds: the value as last entered (units x NAV, or typed),
  // as of priceUpdatedAt. Null = never entered, so valued at what was paid in.
  enteredValue   Decimal?  @db.Decimal(14, 2)

  user        User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  member      FamilyMember?         @relation("InvPrimary", fields: [memberId],      references: [id], onDelete: SetNull)
  bankAccount Account?              @relation("InvestmentBankAccount", fields: [bankAccountId], references: [id], onDelete: SetNull)
  linkedLoans Loan[]                @relation("LoanCollateral")
  collateral  InvestmentCollateral?

  @@index([userId])
  @@index([userId, assetType])
  @@index([memberId])
  @@map("investments")
}

// Real-estate/vehicle-only fields (address, ownership share, projected
// appreciation) kept as an opt-in 1:1 overlay rather than plain nullable
// columns on Investment, same reasoning as OwnershipSplit above -- only
// REAL_ESTATE/VEHICLE rows ever populate this.
model InvestmentCollateral {
  id                       String   @id @default(cuid())
  investmentId             String   @unique
  address                  String?
  ownershipPercent         Decimal? @db.Decimal(5, 2)
  expectedAppreciationRate Decimal? @db.Decimal(5, 2) // % p.a., for projected valuation

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  investment Investment @relation(fields: [investmentId], references: [id], onDelete: Cascade)

  @@map("investment_collateral")
}

model Goal {
  id            String       @id @default(cuid())
  userId        String
  memberId      String?
  name          String
  description   String?
  icon          String?
  color         String?
  goalType      GoalType     @default(CUSTOM)
  priority      GoalPriority @default(MEDIUM)
  status        GoalStatus   @default(ACTIVE)
  targetAmount  Decimal      @db.Decimal(14, 2)
  currentAmount Decimal      @default(0) @db.Decimal(14, 2)
  targetDate    DateTime

  // Planning inputs -- everything the intelligence engine reasons over
  monthlyContribution   Decimal?       @db.Decimal(14, 2) // planned recurring contribution
  expectedReturnRate    Decimal?       @db.Decimal(5, 2)  // % p.a., for growth projection
  expectedInflationRate Decimal?       @db.Decimal(5, 2)  // % p.a., for real-value projection
  riskLevel             GoalRiskLevel?
  fundingAccountId      String?        // which account funds this goal
  notes                 String?

  isCompleted Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user           User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  member         FamilyMember?      @relation(fields: [memberId], references: [id], onDelete: SetNull)
  fundingAccount Account?           @relation("GoalFundingAccount", fields: [fundingAccountId], references: [id], onDelete: SetNull)
  contributions  GoalContribution[]

  @@index([userId])
  @@index([memberId])
  @@map("goals")
}

model GoalContribution {
  id        String           @id @default(cuid())
  goalId    String
  userId    String
  amount    Decimal          @db.Decimal(14, 2)
  date      DateTime
  type      ContributionType @default(ONE_TIME)
  notes     String?
  createdAt DateTime         @default(now())

  goal Goal @relation(fields: [goalId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([goalId])
  @@index([userId])
  @@map("goal_contributions")
}

model Loan {
  paymentDay Int? // optional monthly debit day; defaults to start-date day
  autoDebit  Boolean @default(true) // the bank takes the EMI itself: confirmed on its due date
  id               String   @id @default(cuid())
  userId           String
  memberId         String?  // who is the borrower
  payerMemberId    String?  // who pays the EMI (may differ from borrower)
  bankAccountId    String?  // which account the loan is linked to
  linkedInvestmentId String? // collateral asset this loan funded (Property, Vehicle, ...) -- EMI principal builds its equity instead of counting as an expense
  name             String
  loanType         LoanType
  principal        Decimal  @db.Decimal(14, 2)
  interestRate     Decimal  @db.Decimal(5, 2)
  emi              Decimal  @db.Decimal(14, 2)
  remainingBalance Decimal  @db.Decimal(14, 2) // cache: openingBalance less principal repaid through recorded payments (schedule/progress)
  // Balance when the loan was entered (or last corrected by hand); recorded EMIs and prepayments come off it.
  openingBalance   Decimal  @default(0) @db.Decimal(14, 2)
  tenureMonths     Int
  startDate        DateTime
  lender           String?
  notes            String?
  isActive         Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  user             User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  member           FamilyMember?  @relation("LoanBorrower", fields: [memberId], references: [id], onDelete: SetNull)
  payer            FamilyMember?  @relation("LoanPayer",    fields: [payerMemberId], references: [id], onDelete: SetNull)
  bankAccount      Account?       @relation("LoanBankAccount", fields: [bankAccountId], references: [id], onDelete: SetNull)
  linkedInvestment Investment?    @relation("LoanCollateral", fields: [linkedInvestmentId], references: [id], onDelete: SetNull)

  @@index([userId])
  events           LoanEvent[]
  @@index([memberId])
  @@index([linkedInvestmentId])
  @@map("loans")
}

// ─── Recurring Bills & Commitments ───────────────────────────────────────────
//
// A RecurringBill is the *definition* of a commitment (Netflix, rent, insurance
// premium, gym...). Future occurrences are never stored -- they are projected on
// the fly from (startDate, frequency, endDate) by lib/billSchedule.ts. Only
// *materialized events* (an occurrence the user paid or explicitly skipped) get
// a due_status row. This keeps the schema normalized, makes month-skipping
// non-destructive, and lets forecasts extend arbitrarily far without row bloat.

model RecurringBill {
  id       String  @id @default(cuid())
  userId   String
  memberId String?

  name     String
  vendor   String? // who gets paid: "Netflix", "Airtel", "LIC", landlord's name...
  category String  @default("Other") // free-form -- unlimited categories, suggested list lives in shared constants
  // The category on the Category table (same list as transactions and budgets); `category` text kept for now.
  categoryId String?
  icon     String?
  color    String?

  amount   Decimal @db.Decimal(12, 2)
  currency String  @default("INR")

  frequency          BillFrequency @default(MONTHLY)
  customIntervalDays Int? // only for frequency = CUSTOM: repeat every N days

  startDate DateTime // anchor: the first due date; day-of-month is the anchor day for monthly-family cycles
  endDate   DateTime? // optional: no occurrences projected after this

  reminderDays  Int     @default(3) // notify N days before each due date
  autoDebit     Boolean @default(false)
  paymentMethod String? // UPI, Debit Card, Credit Card, Net Banking, Cash...
  accountId     String? // bank account the bill is debited from
  creditCardId  String? // or the credit card it's charged to

  status      BillStatus @default(ACTIVE)
  pausedUntil DateTime? // PAUSED + date = auto-resume after; PAUSED + null = until manually resumed

  url   String?
  notes String?
  tags  String[] @default([])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  member      FamilyMember?    @relation(fields: [memberId], references: [id], onDelete: SetNull)
  account     Account?         @relation("BillAccount", fields: [accountId], references: [id], onDelete: SetNull)
  creditCard  CreditCard?      @relation("BillCreditCard", fields: [creditCardId], references: [id], onDelete: SetNull)
  categoryRef Category?        @relation("BillCategory", fields: [categoryId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([userId, status])
  @@index([userId, category])
  @@index([memberId])
  @@map("recurring_bills")
}

// Read-only since due_status (2026-11): kept for one round, then to be dropped.
model CreditCard {
  bankAccountId String?
  bankAccount Account? @relation("CardPaymentAccount", fields: [bankAccountId], references: [id], onDelete: SetNull)
  id             String   @id @default(cuid())
  userId         String
  memberId       String?
  cardName       String
  bank           String?
  lastFourDigits String?
  creditLimit    Decimal  @db.Decimal(12, 2)
  outstanding    Decimal  @default(0) @db.Decimal(12, 2)
  minimumPayment Decimal? @db.Decimal(10, 2)
  dueDate        DateTime
  statementDate  DateTime?
  interestRate   Decimal? @db.Decimal(5, 2)
  color          String?
  notes          String?
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  member         FamilyMember?   @relation(fields: [memberId], references: [id], onDelete: SetNull)
  cardEmis       CardEMI[]
  recurringBills RecurringBill[] @relation("BillCreditCard")
  statements     CardStatement[]
  expenses       CardExpense[]

  @@index([userId])
  @@map("credit_cards")
}

model CardEMI {
  id           String   @id @default(cuid())
  userId       String
  creditCardId String
  memberId     String?
  itemName     String
  totalAmount  Decimal  @db.Decimal(12, 2)
  emiAmount    Decimal  @db.Decimal(10, 2)
  tenureMonths Int
  emisPaid     Int      @default(0)
  isNoCost     Boolean  @default(true)
  interestRate Decimal? @db.Decimal(5, 2)
  startDate    DateTime
  notes        String?
  isArchived   Boolean  @default(false)
  autoDebit    Boolean  @default(true) // billed on the card automatically: confirmed on its due date
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user       User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  creditCard CreditCard     @relation(fields: [creditCardId], references: [id], onDelete: Cascade)
  member     FamilyMember?  @relation(fields: [memberId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([creditCardId])
  @@index([memberId])
  @@map("card_emis")
}

model P2PLoan {
  id              String   @id @default(cuid())
  userId          String
  memberId        String?
  personName      String
  type            P2PType
  amount          Decimal  @db.Decimal(12, 2)
  remainingAmount Decimal  @db.Decimal(12, 2)
  date            DateTime
  dueDate         DateTime?
  description     String?
  notes           String?
  isSettled       Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user   User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  member FamilyMember?  @relation(fields: [memberId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([memberId])
  @@map("p2p_loans")
}

model RefreshToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique // SHA-256 hash, never the raw token -- defense in depth if the DB leaks
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

model NetWorthSnapshot {
  id               String   @id @default(cuid())
  userId           String
  date             DateTime @db.Date // one row per user per calendar day
  netWorth         Decimal  @db.Decimal(14, 2)
  totalAssets      Decimal  @db.Decimal(14, 2)
  totalLiabilities Decimal  @db.Decimal(14, 2)
  createdAt        DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@index([userId])
  @@map("net_worth_snapshots")
}


model Budget {
  id           String   @id @default(cuid())
  userId       String
  categoryId   String
  monthlyLimit Decimal  @db.Decimal(14, 2)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([userId, categoryId])
  @@index([userId])
  @@map("budgets")
}

// An opt-in overlay for co-ownership: most transactions/investments belong to
// one member (memberId, on the entity itself). A row here only exists when the
// user has explicitly split that specific entity with a second member -- so
// single-member households (and the common single-owner case) carry zero
// extra columns anywhere.
model OwnershipSplit {
  id                String          @id @default(cuid())
  userId            String
  entityType        SplitEntityType
  entityId          String
  secondaryMemberId String
  ratio             Decimal         @default(50) @db.Decimal(5, 2) // % owned by the entity's own memberId; rest to secondaryMemberId
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  user            User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  secondaryMember FamilyMember @relation("SplitSecondaryMember", fields: [secondaryMemberId], references: [id], onDelete: Cascade)

  @@unique([entityType, entityId])
  @@index([userId])
  @@map("ownership_splits")
}

// The month sheet frozen at month end: the paper sheet for every past month.
model MonthClose {
  id          String   @id @default(cuid())
  userId      String
  month       String // YYYY-MM
  // Per person: salary, loans, investments, bills, card spending, left, free, spent so far, still free.
  members     Json
  combined    Json
  netWorth    Decimal  @db.Decimal(16, 2)
  totalDebt   Decimal  @db.Decimal(16, 2)
  // Bank account balances at month end: [{ accountId, name, balance }].
  balances    Json
  // Worked out later from today's data (balances rolled back through the ledger), not frozen on the day.
  approximate Boolean  @default(false)
  closedAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, month])
  @@map("month_close")
}

// Household preferences that are not about any one record.
model UserSettings {
  id               String   @id @default(cuid())
  userId           String   @unique
  // Buffer target in rupees; null = 3 x the month's commitments (loans, EMIs, investments, bills).
  bufferTarget     Decimal? @db.Decimal(14, 2)
  // Accounts whose balance counts as buffer; empty = every active savings account.
  bufferAccountIds String[] @default([])
  // Last balance check-in on Net worth (even when every balance matched).
  balancesCheckedAt DateTime?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_settings")
}

// What happened to one scheduled instalment (schedule engine, backend/src/schedule).
// Replaces monthly_payments and bill_occurrences, which are kept read-only for now.
model DueStatus {
  id             String           @id @default(cuid())
  userId         String
  // LOAN | CARD_EMI | INVESTMENT | BILL | CARD_STATEMENT, or INVESTMENT_PURCHASE (period ONCE) for a one-off buy
  itemType       String
  itemId         String
  period         String // YYYY-MM the instalment belongs to
  // Bills: the occurrence's date (YYYY-MM-DD), as a bill can fall more than once a month. Empty otherwise.
  dueKey         String           @default("")
  dueDate        DateTime? // bills: the scheduled occurrence date
  status         DuePaymentStatus
  amount         Decimal?         @db.Decimal(14, 2)
  paidDate       DateTime?
  accountId      String?
  transactionIds String[]         @default([])
  notes          String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, itemType, itemId, period, dueKey])
  @@index([userId, period])
  @@index([itemType, itemId])
  @@map("due_status")
}

// Salary actually received by a family member in a given month (YYYY-MM).
model MonthlySalary {
  id        String   @id @default(cuid())
  userId    String
  memberId  String
  month     String
  amount    Decimal  @db.Decimal(14, 2)
  note      String?
  // The bank account the salary landed in. Its INCOME ledger entry
  // (sourceType SALARY, sourceId = this id) credits this account.
  accountId String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user    User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  member  FamilyMember @relation(fields: [memberId], references: [id], onDelete: Cascade)
  account Account?     @relation("SalaryAccount", fields: [accountId], references: [id], onDelete: SetNull)

  @@unique([userId, memberId, month])
  @@map("monthly_salaries")
}

// Loan history beyond monthly EMIs: prepayments, rate changes, closing.
model LoanEvent {
  id            String   @id @default(cuid())
  userId        String
  loanId        String
  type          String   // PREPAYMENT | RATE_CHANGE | CLOSED
  date          DateTime @default(now())
  amount        Decimal? @db.Decimal(14, 2)
  balanceBefore Decimal? @db.Decimal(14, 2)
  balanceAfter  Decimal? @db.Decimal(14, 2)
  oldRate       Decimal? @db.Decimal(5, 2)
  newRate       Decimal? @db.Decimal(5, 2)
  oldEmi        Decimal? @db.Decimal(14, 2)
  newEmi        Decimal? @db.Decimal(14, 2)
  accountId     String?
  transactionId String?
  note          String?
  createdAt     DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  loan Loan @relation(fields: [loanId], references: [id], onDelete: Cascade)

  @@index([loanId])
  @@map("loan_events")
}

// A card's monthly statement as the bank printed it. `month` is the due month
// (YYYY-MM): payments against it live on its CARD_STATEMENT due_status row
// for that month, so Pay / Undo work the same as everywhere else.
model CardStatement {
  id            String   @id @default(cuid())
  userId        String
  creditCardId  String
  month         String
  periodStart   DateTime
  statementDate DateTime
  dueDate       DateTime
  totalDue      Decimal  @db.Decimal(12, 2)
  minimumDue    Decimal? @db.Decimal(12, 2)
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  creditCard CreditCard @relation(fields: [creditCardId], references: [id], onDelete: Cascade)

  @@unique([creditCardId, month])
  @@index([userId])
  @@map("card_statements")
}

// A one-off purchase on a card (not an EMI). It bills on the statement due in
// `statementMonth`. No money moves until the card bill is paid, unless it was
// paid off straight away (paidDate / paidFromAccountId / transactionId set).
model CardExpense {
  id                String    @id @default(cuid())
  userId            String
  creditCardId      String
  memberId          String?
  name              String
  amount            Decimal   @db.Decimal(12, 2)
  date              DateTime
  category          String    @default("Other")
  // The category on the Category table (same list as transactions and budgets); `category` text kept for now.
  categoryId        String?
  statementMonth    String
  // A plan payment made on the card (e.g. a gold scheme instalment), already
  // counted in its own bucket on Home: INVESTMENT | LOAN | BILL + its id.
  linkedType        String?
  linkedId          String?
  paidDate          DateTime?
  paidFromAccountId String?
  transactionId     String?
  notes             String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  user       User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  creditCard CreditCard    @relation(fields: [creditCardId], references: [id], onDelete: Cascade)
  categoryRef Category?  @relation("CardExpenseCategory", fields: [categoryId], references: [id], onDelete: SetNull)
  member     FamilyMember? @relation(fields: [memberId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([creditCardId, statementMonth])
  @@map("card_expenses")
}
